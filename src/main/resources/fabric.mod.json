			"dev.comfyfluffy.caustica.CausticaMod"
		],
		"client": [
			"dev.comfyfluffy.caustica.client.CausticaClient"
		]
	},
	"mixins": [
		"caustica.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "26.2",
		"java": ">=25",
		"fabric-api": "*"
